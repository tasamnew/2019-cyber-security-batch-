// Prisma schema for the 2019 Cyber Security Student Group hub.
// Datasource is PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

// `prisma generate` validates this block, so it must be able to resolve the
// variable even on a build machine where no database is reachable. The
// placeholder below is never used to connect — it exists purely so client
// generation succeeds; runtime and `migrate deploy` use the real DATABASE_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MODERATOR
  STUDENT
  GUEST
}

enum UserStatus {
  PENDING // registered, awaiting admin approval
  APPROVED // active member
  BLOCKED // suspended
}

enum PostStatus {
  PUBLISHED
  HIDDEN // soft-deleted / hidden by moderation
}

enum ChannelKind {
  PUBLIC
  PRIVATE
}

enum MessageType {
  TEXT
  SYSTEM
  FILE
}

enum ResourceKind {
  LINK
  FILE
}

enum AssignmentType {
  ASSIGNMENT
  LAB
  PROJECT
  EXAM
  DEADLINE
}

enum AssignmentStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  DONE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SPAM
  HARASSMENT
  OFF_TOPIC
  MALICIOUS_CONTENT
  COPYRIGHT
  OTHER
}

enum ReportTarget {
  POST
  COMMENT
  RESOURCE
  FILE
  MESSAGE
  USER
}

enum CtfDifficulty {
  EASY
  MEDIUM
  HARD
  INSANE
}

// ---------------------------------------------------------------------------
// USERS / AUTH
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(GUEST)
  status       UserStatus @default(PENDING)
  bio          String?
  avatarSeed   String     @default("0f172a")
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Security: failed-login throttling + manual admin lockout
  failedLoginCount Int       @default(0)
  lockedUntil     DateTime?

  // Relations
  posts           Post[]
  comments        Comment[]
  votes           Vote[]
  messages        Message[]
  sentMessages    Message[]     @relation("DirectMessages")
  channels        ChannelMember[]
  conversations   Conversation[] @relation("ConversationSender")
  receivedConversations Conversation[] @relation("ConversationRecipient")
  resources       Resource[]
  uploadedFiles   FileAsset[]
  ctfChallenges   CtfChallenge[]
  ctfSolves       CtfSolve[]
  ownedAssignments   Assignment[] @relation("Assignee")
  createdAssignments Assignment[] @relation("AssignmentCreator")
  announcements   Announcement[]
  createdChannels Channel[]
  reports         Report[]         @relation("Reporter")
  resolvedReports Report[]         @relation("Resolver")
  sessions        Session[]
  moderationLog   ModerationLog[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([role])
}

// Server-side session records. The JWT is short-lived; this table lets an admin
// revoke a session immediately and detects token theft after a password change.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// FORUM
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  color       String   @default("#3dd6ff") // neon accent used in the UI
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  posts Post[]
}

model Post {
  id         String     @id @default(cuid())
  title      String
  body       String // markdown source
  slug       String     @unique
  status     PostStatus @default(PUBLISHED)
  isPinned   Boolean    @default(false)
  viewCount  Int        @default(0)
  tags       String[]   @default([])
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  comments Comment[]
  // `votes` are not a Prisma relation: Vote is polymorphic (see model Vote), so
  // vote counts are aggregated by (targetType, targetId) in application code.

  @@index([categoryId, createdAt])
  @@index([status, isPinned])
  @@index([authorId])
}

model Comment {
  id        String     @id @default(cuid())
  body      String // markdown source
  status    PostStatus @default(PUBLISHED)
  score     Int        @default(0)
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String? // threaded replies
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("CommentReplies")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // See Post.votes — Comment votes are also polymorphic.

  @@index([postId, createdAt])
  @@index([authorId])
}

// Polymorphic upvote/downvote. targetId is either a Post.id or a Comment.id.
// Enforced in application code since Postgres has no polymorphic FKs.
model Vote {
  id         String   @id @default(cuid())
  value      Int      // +1 upvote, -1 downvote
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // 'POST' | 'COMMENT'
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// CHAT
// ---------------------------------------------------------------------------

model Channel {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  topic       String?
  kind        ChannelKind @default(PUBLIC)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  members  ChannelMember[]
  messages Message[]

  @@index([kind])
}

model ChannelMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([userId, channelId])
}

model Message {
  id          String      @id @default(cuid())
  body        String
  type        MessageType @default(TEXT)
  channelId   String?
  channel     Channel?    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  // Direct message: set recipientId, leave channelId null.
  recipientId String?
  recipient   User?       @relation("DirectMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  attachmentId String?
  attachment  FileAsset?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  editedAt    DateTime?

  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
  @@index([senderId, recipientId, createdAt])
}

// A 1:1 DM thread.
model Conversation {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("ConversationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ConversationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]

  @@unique([senderId, recipientId])
  @@index([senderId])
  @@index([recipientId])
}

// ---------------------------------------------------------------------------
// FILES / RESOURCES
// ---------------------------------------------------------------------------

model FileAsset {
  id            String   @id @default(cuid())
  originalName  String
  storedName    String   @unique // opaque name on disk, never derived from user input
  mimeType      String
  sizeBytes     Int
  sha256        String
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  resources Resource[]
  messages  Message[]

  @@index([uploadedById])
}

model Resource {
  id           String       @id @default(cuid())
  title        String
  description  String?
  tags         String[]     @default([])
  kind         ResourceKind @default(LINK)
  url          String? // LINK resources
  fileId       String?
  file         FileAsset?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([kind])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// CTF
// ---------------------------------------------------------------------------

model CtfChallenge {
  id          String        @id @default(cuid())
  title       String
  description String // markdown; hints are spoiler-hidden
  url         String?
  category    String
  difficulty  CtfDifficulty @default(MEDIUM)
  points      Int           @default(0)
  hints       String[]      @default([])
  writeUpUrl  String?
  // Never store the raw flag: keep an HMAC so submissions can be verified
  // server-side without the plaintext ever leaving the request that set it.
  flagHash    String?
  solves      CtfSolve[]
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([difficulty])
  @@index([createdById])
}

// One row per member who cracked a challenge. The unique pair stops duplicate
// solves from inflating the scoreboard.
model CtfSolve {
  id          String       @id @default(cuid())
  challengeId String
  challenge   CtfChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int          @default(0)
  solvedAt    DateTime     @default(now())

  @@unique([challengeId, userId])
  @@index([userId])
  @@index([solvedAt])
}

// ---------------------------------------------------------------------------
// ASSIGNMENTS / TRACKER
// ---------------------------------------------------------------------------

model Assignment {
  id          String           @id @default(cuid())
  title       String
  description String?
  courseCode  String?
  type        AssignmentType   @default(ASSIGNMENT)
  status      AssignmentStatus @default(TODO)
  dueAt       DateTime?
  ownerId     String? // null = unassigned on the shared board
  owner       User?            @relation("Assignee", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User             @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([dueAt])
  @@index([ownerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// MODERATION / ANNOUNCEMENTS / AUDIT
// ---------------------------------------------------------------------------

model Report {
  id           String       @id @default(cuid())
  targetType   ReportTarget
  targetId     String
  reason       ReportReason
  details      String?
  status       ReportStatus @default(OPEN)
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedById String?
  resolvedBy   User?        @relation("Resolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([status])
  @@index([targetType, targetId])
}

// Immutable log of administrative actions (approvals, role changes, deletions).
model ModerationLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(true)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}