# ---- Database ----
# PostgreSQL connection string. Create the database first:
#   createdb cs_hub
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cs_hub?schema=public"

# ---- Auth ----
# 48 random bytes, base64url. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ---- App ----
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Max upload size in megabytes (admin-overridable at runtime)
MAX_UPLOAD_MB="25"

# ---- Super admin bootstrap ----
# Comma-separated emails promoted to ADMIN/APPROVED on server start. Accounts
# that do not exist yet are created with SUPERADMIN_PASSWORD (min 10 chars,
# mixed case + digit). Remove the password once the accounts exist.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
